---
import "../../styles.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Overgrow</title>
    <meta
      name="description"
      content="A brick breaker where the wall grows back. Chipping away evenly never finishes it, so the only way out is above."
    />

    <!--
      The link-preview card: public/card.png, 1200x630. The URL resolves against
      this page, like any link. No og:title/og:description: scrapers fall back
      to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}/card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
      The brief bans instructions, not landmarks. This nav is the navigation
      landmark the invariants require, kept off the play surface because a
      single-screen game has nowhere to send you and any visible chrome over
      the canvas would be one more thing between a stranger and their first move.
    -->
    <nav aria-label="Primary" class="offscreen">
      <a href={import.meta.env.BASE_URL}>Home</a>
    </nav>

    <main>
      <h1 class="nameplate">Overgrow</h1>

      <!--
        Icon-only, and never the way into the game: the paddle still starts play
        on the first pointer move, so nothing here has to be found or pressed
        first. aria-label carries the meaning that the glyph implies.
      -->
      <div class="controls" data-controls data-paused="false">
        <button class="control" type="button" data-action="pause" aria-label="Pause" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect class="bar-left" x="7" y="5" width="3.6" height="14" rx="1.4" />
            <rect class="bar-right" x="13.4" y="5" width="3.6" height="14" rx="1.4" />
            <path class="play-head" d="M8.5 5.2 19 12 8.5 18.8Z" />
          </svg>
        </button>
        <button class="control" type="button" data-action="new-game" aria-label="New game">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M19 12a7 7 0 1 1-2.05-4.95"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
            />
            <path d="M19.6 4.2v4.4h-4.4Z" />
          </svg>
        </button>
      </div>

      <canvas id="play"></canvas>
      <div class="outcome" data-outcome-panel data-shown="false">
        <p class="outcome-word" data-testid="outcome" aria-live="polite"></p>
        <span class="replay" aria-hidden="true">&#8635;</span>
      </div>
    </main>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
