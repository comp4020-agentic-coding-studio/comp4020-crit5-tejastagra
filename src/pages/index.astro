---
import "../../styles.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Overgrow</title>
    <meta
      name="description"
      content="A brick breaker where the wall grows back. Chipping away evenly never finishes it, so the only way out is above."
    />

    <!--
      The link-preview card: public/card.png, 1200x630. The URL resolves against
      this page, like any link. No og:title/og:description: scrapers fall back
      to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}/card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
      The brief bans instructions, not landmarks. This nav is the navigation
      landmark the invariants require, kept off the play surface because a
      single-screen game has nowhere to send you and any visible chrome over
      the canvas would be one more thing between a stranger and their first move.
    -->
    <nav aria-label="Primary" class="offscreen">
      <a href={import.meta.env.BASE_URL}>Home</a>
    </nav>

    <main>
      <h1 class="nameplate">Overgrow</h1>
      <canvas id="play"></canvas>
      <div class="outcome" data-outcome-panel data-shown="false">
        <p class="outcome-word" data-testid="outcome" aria-live="polite"></p>
        <span class="replay" aria-hidden="true">&#8635;</span>
      </div>
    </main>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
