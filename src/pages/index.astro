---
import "../../styles.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brick Breaker Remastered</title>
    <meta
      name="description"
      content="A brick breaker where the wall grows back while you are still breaking it, rebuilt from the one that came on a BlackBerry Bold."
    />

    <!--
      The link-preview card: public/card.png, 1200x630. The URL resolves against
      this page, like any link. No og:title/og:description: scrapers fall back
      to the <title> and description above.
    -->
    <!-- A three-row wall, drawn on the same pixel grid as the game. -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' shape-rendering='crispEdges'%3E%3Crect width='16' height='16' fill='%230a0a0a'/%3E%3Crect x='1' y='2' width='6' height='3' fill='%23e5484d'/%3E%3Crect x='9' y='2' width='6' height='3' fill='%23e5484d'/%3E%3Crect x='1' y='6' width='6' height='3' fill='%23f5a524'/%3E%3Crect x='9' y='6' width='6' height='3' fill='%23f5a524'/%3E%3Crect x='1' y='10' width='6' height='3' fill='%233fae4a'/%3E%3Crect x='12' y='13' width='3' height='2' fill='%23c9ccd4'/%3E%3C/svg%3E"
    />

    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}/card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
      The brief bans instructions, not landmarks. This nav is the navigation
      landmark the invariants require, kept off the play surface because a
      single-screen game has nowhere to send you and any visible chrome over
      the canvas would be one more thing between a stranger and their first move.
    -->
    <nav aria-label="Primary" class="offscreen">
      <a href={import.meta.env.BASE_URL}>Home</a>
    </nav>

    <main>
      <h1 class="nameplate">Brick Breaker Remastered</h1>

      <!--
        Icon-only, and never the way into the game: the paddle still starts play
        on the first pointer move, so nothing here has to be found or pressed
        first. aria-label carries the meaning that the glyph implies.
      -->
      <div class="controls" data-controls data-paused="false">
        <button class="control" type="button" data-action="pause" aria-label="Pause" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect class="bar-left" x="7" y="5" width="3.6" height="14" rx="1.4" />
            <rect class="bar-right" x="13.4" y="5" width="3.6" height="14" rx="1.4" />
            <path class="play-head" d="M8.5 5.2 19 12 8.5 18.8Z" />
          </svg>
        </button>
        <button class="control" type="button" data-action="new-game" aria-label="New game">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M19 12a7 7 0 1 1-2.05-4.95"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
            />
            <path d="M19.6 4.2v4.4h-4.4Z" />
          </svg>
        </button>
      </div>

      <!--
        The stats live in the DOM rather than on the canvas. The play field is
        drawn into a deliberately low-resolution buffer and magnified, which is
        what gives it its chunky edges, but text put through that same pipeline
        comes out as magnified antialiasing and is barely readable. Real text
        stays crisp, and a screen reader can reach it.
      -->
      <!--
        One wrapper so the same stats can be two columns beside the field on a
        desktop and a single strip across the top on a phone, without the
        renderer having to keep two copies of anything in sync. `data-compact`
        marks the ones worth the room on a small screen; `data-short` carries a
        label that fits when the full one does not.
      -->
      <div class="panels">
        <aside class="panel panel-left" data-panel aria-label="Run">
          <p data-compact><span>Level</span><b data-stat="level">1/2</b></p>
          <p data-compact><span>Time</span><b data-stat="time">0:00</b></p>
          <p><span>Tiles smashed</span><b data-stat="broken">0</b></p>
          <p><span>Lives</span><b class="hearts" data-stat="lives"></b></p>
        </aside>

        <aside class="panel panel-right" data-panel aria-label="Wall">
          <p data-compact data-short="Down"><span>Tiles down</span><b data-stat="down">0/12</b></p>
          <p>
            <span>Next one back</span>
            <i class="meter"><i class="meter-fill" data-stat="next"></i></i>
          </p>
          <p data-compact data-short="Back in">
            <span>Smashed tiles come back in</span><b data-stat="regrow">22s</b>
          </p>
          <p data-stat="best-row" hidden><span>Best</span><b data-stat="best">—</b></p>
        </aside>
      </div>

      <!-- Cloned once per life by the renderer. Drawn on the same pixel grid
           as the game, so it reads as part of the same thing. -->
      <template data-heart>
        <svg class="heart" viewBox="0 0 8 6" aria-hidden="true" focusable="false">
          <rect x="1" y="0" width="2" height="1" />
          <rect x="5" y="0" width="2" height="1" />
          <rect x="0" y="1" width="8" height="2" />
          <rect x="1" y="3" width="6" height="1" />
          <rect x="2" y="4" width="4" height="1" />
          <rect x="3" y="5" width="2" height="1" />
        </svg>
      </template>

      <!-- Says which wall you are on when it changes. Not an instruction: it
           reports what just happened, the way the ending does. -->
      <p class="banner" data-banner data-shown="false" aria-live="polite"></p>

      <canvas id="play"></canvas>
      <div class="outcome" data-outcome-panel data-shown="false">
        <p class="outcome-word" data-testid="outcome" aria-live="polite"></p>
        <span class="replay" aria-hidden="true">&#8635;</span>
      </div>
    </main>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
